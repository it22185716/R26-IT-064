# Firebase web config (public client keys — see src/lib/firebase.ts)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-only, used by src/lib/firebaseAdmin.ts for API
# Route Handlers — these run with no signed-in user, so they authenticate as
# a service account instead of relying on Firestore Security Rules).
# Get these from: Firebase Console → Project Settings → Service Accounts →
# Generate new private key. That downloads a JSON file containing
# project_id / client_email / private_key — copy them here. Keep
# FIREBASE_ADMIN_PRIVATE_KEY's "\n" sequences literal (don't unescape them
# yourself); src/lib/firebaseAdmin.ts converts them at runtime.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ML service URLs (defaults match each service's own port if unset)
MEAL_PLAN_SERVICE_URL=http://127.0.0.1:5001
VIDEO_RECOMMENDATION_SERVICE_URL=http://127.0.0.1:5002
READING_SERVICE_URL=http://127.0.0.1:5003
MATH_WEAKNESS_SERVICE_URL=http://127.0.0.1:5004
